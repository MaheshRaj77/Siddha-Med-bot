# Supabase PostgreSQL (Transaction Pooler URL)
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase PostgreSQL (Session URL for direct DB connections & Migrations)
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Application and Supabase Auth
APP_ORIGIN="https://your-production-domain.example"
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-SUPABASE-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SUPABASE-SERVICE-ROLE-KEY]"

# Upstash Redis (For Rate Limiting via HTTP)
UPSTASH_REDIS_REST_URL="https://[YOUR-UPSTASH-URL].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR-UPSTASH-TOKEN]"

# Upstash Redis (For BullMQ via native socket connection)
REDIS_URL="rediss://default:[YOUR-UPSTASH-TOKEN]@[YOUR-UPSTASH-URL].upstash.io:6379"
ENABLE_WORKER="true"

# LangSmith (Observability)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT="MedBot-RAG-Prod"
LANGCHAIN_API_KEY="[YOUR-LANGSMITH-API-KEY]"

# Models
NVIDIA_API_KEY="[YOUR-NVIDIA-API-KEY]"
COHERE_API_KEY="[YOUR-COHERE-API-KEY]"

# ChromaDB
CHROMA_TENANT="[YOUR-CHROMA-TENANT]"
CHROMA_DATABASE="[YOUR-CHROMA-DATABASE]"
CHROMA_API_KEY="[YOUR-CHROMA-API-KEY]"

# Razorpay Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_5ded8ba12e5344"
RAZORPAY_KEY_SECRET="mock_secret_key_id"
